# Optional self-hosted Node endpoint settings.
# The GitHub Pages static build does not read these values or run this server.
# Leave disabled for preview; enable only after configuring and privacy-reviewing a separate host.
ANALYTICS_ENABLED=false
# Optional comma-separated exact Origins for a reviewed reverse proxy (for example, https://example.com).
ANALYTICS_ALLOWED_ORIGINS=
HOST=127.0.0.1
PORT=4173
ANALYTICS_STORE=.local/analytics.json
ANALYTICS_RETENTION_DAYS=90
