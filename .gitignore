# Generated analytics data (aggregate counts; never commit)
analytics-data/
# Local tooling
node_modules/
.DS_Store
*.tmp
# Python tooling (editorial register build)
__pycache__/
*.pyc
.venv/

# Never commit a regenerated legacy tree at the repository root. The frozen
# editions live under legacy/ only, where they are unambiguously archived.
/docs/
# ...except the retirement page for the old /docs/ edition. It has to be tracked
# or the deletion never reaches GitHub Pages, and the stale edition keeps being
# served with Amazon prices on it. See FLG-031.
!/docs/
/docs/*
!/docs/index.html
/editorial-legacy/
